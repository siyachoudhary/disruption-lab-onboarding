# Copy to .env and fill in real values.

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/disruption_lab

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Auto-delete accounts after this many days of inactivity (180 = ~6 months)
INACTIVITY_DAYS=180

# --- Email reminders (optional) ---
# If these are blank, reminders are simply skipped (no crash).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Disruption Lab <onboarding@disruptionlab.dev>"

# A student is "off track" if inactive this many days without finishing.
REMINDER_AFTER_DAYS=3
